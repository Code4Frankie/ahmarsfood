# Only needed when the API is on a different domain than the website (production).
# Leave empty in development: Vite proxies /api to http://localhost:5000.
VITE_API_URL=

# Build only (Vercel): the pre-render step reads the menu from the API, so it needs the full API address.
# If VITE_API_URL above is already the full address you do not need this.
PRERENDER_API_URL=
