# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=                     # at least 32 random characters
FRONTEND_URL=http://localhost:5173   # comma-separate multiple origins
API_URL=http://localhost:5000        # public URL of this API (used for payment callbacks)

# --- Paystack ---
PAYSTACK_SECRET_KEY=

# --- Opay (sandbox base URL shown; use https://api.opaycheckout.com for live) ---
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=
OPAY_BASE_URL=https://sandboxapi.opaycheckout.com

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Restaurant (Maraba Akunza, Federal University Lafia) ---
# PLACEHOLDER = centre of Lafia. Replace with the restaurant's exact pin (right-click it in Google/OpenStreetMap maps).
RESTAURANT_LAT=8.4966
RESTAURANT_LNG=8.5153
MAX_DELIVERY_RADIUS_KM=5

# --- Delivery fee = DELIVERY_BASE_FEE + DELIVERY_PER_KM x distance (Naira). PLACEHOLDER values: confirm with the restaurant ---
DELIVERY_BASE_FEE=300
DELIVERY_PER_KM=100
MAX_POD_AMOUNT=20000            # largest Pay on Delivery order allowed (Naira)

# --- Dispatch ---
OFFER_TIMEOUT_SECONDS=120
RIDER_LOCATION_STALE_SECONDS=120

# --- Seed script only (creates the first admin). Leave ADMIN_PASSWORD empty to get a random one printed once ---
ADMIN_NAME=Ahmars Admin
ADMIN_PHONE=08114077101
ADMIN_PASSWORD=

# --- Shopping assistant (Anthropic). Key stays on the server; never put it in the frontend ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5        # switch to claude-sonnet-5-5 for stronger answers
AGENT_MAX_STEPS=8                   # tool-use rounds per question
AGENT_MAX_TOKENS=1024
AGENT_RATE_LIMIT_PER_HOUR=60        # per signed-in user
AGENT_TIMEOUT_SECONDS=60
AGENT_LOG_TTL_DAYS=90               # tool-call logs are deleted after this many days
AGENT_CONFIRM_TTL_SECONDS=600       # how long a pending confirmation stays valid

# --- SEO crawler (runs as a separate Render Cron Job: see README) ---
CRAWL_BASE_URL=https://ahmarsfood.frankiecode.org.ng   # the public site to audit
CRAWL_RATE_MS=1000                  # pause between pages
CRAWL_MAX_PAGES=200
CRAWL_RENDER_JS=true                # false = skip Playwright (faster, but a React app then looks empty)
SEO_HISTORY_DAYS=365                # audit history kept for this long
SEO_SUGGESTIONS_PER_HOUR=30         # admin limit for AI-written SEO copy
SEO_QUEUE_BATCH=10                  # pages queued per "queue pages missing descriptions" click

# --- Keep the saved (pre-rendered) pages current: optional ---
# Vercel project > Settings > Git > Deploy Hooks > create one, paste its address here. Menu changes then trigger a rebuild
# (waiting REBUILD_DELAY_SECONDS so several edits in a row cause only one rebuild). Leave empty to rebuild by hand.
VERCEL_DEPLOY_HOOK_URL=
REBUILD_DELAY_SECONDS=120
